{
  "name": "@blokwise/ts-json-schema-generator",
  "type": "module",
  "version": "2.6.0",
  "packageManager": "pnpm@10.28.0",
  "description": "Generate JSON schema from your Typescript sources",
  "author": {
    "name": "Julian Derungs",
    "email": "julian.derungs@deepbase.ch",
    "url": "https://github.com/aerophobic"
  },
  "contributors": [
    {
      "name": "Alexander Evtushenko",
      "email": "aevtushenko@xiag.ch"
    },
    {
      "name": "Dominik Moritz",
      "email": "domoritz@gmail.com"
    },
    {
      "name": "MooYeol Prescott Lee",
      "email": "mooyoul@gmail.com"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blokwise/ts-json-schema-generator.git"
  },
  "keywords": [
    "ts",
    "typescript",
    "json",
    "schema",
    "jsonschema"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.mts"
      ]
    }
  },
  "bin": {
    "ts-json-schema-generator": "dist/bin/ts-json-schema-generator.mjs"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "debug": "tsx --inspect-brk dist/bin/ts-json-schema-generator.mjs",
    "watch": "tsc -w",
    "run": "tsx src/bin/ts-json-schema-generator.ts",
    "test": "echo 'ok'",
    "test:ci": "nr test",
    "test:unit": "vitest run --project unit",
    "test:debug": "tsx --inspect-brk --test-concurrency=1 --test",
    "test:fast": "cross-env FAST_TEST=1 tsx --test \"test/**/*.test.ts\"",
    "test:update": "cross-env FAST_TEST=1 UPDATE_SCHEMA=true tsx --test \"test/**/*.test.ts\"",
    "test:coverage": "c8 --reporter lcov --reporter text tsx --test \"test/**/*.test.ts\"",
    "prepack": "obuild",
    "release": "NPM_TOKEN=$DAGGERBASE_RELEE_NPM_TOKEN RELEE_GH_TOKEN=$DAGGERBASE_RELEE_GH_TOKEN relee"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "commander": "^14.0.3",
    "json-schema": "^0.4.0",
    "json5": "^2.2.3",
    "normalize-path": "^3.0.0",
    "safe-stable-stringify": "^2.5.0",
    "std-env": "^3.10.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "7.2.0",
    "@blokwise/relee": "^0.2.4",
    "@types/node": "25.2.0",
    "@types/normalize-path": "^3.0.2",
    "@typescript/vfs": "1.6.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "c8": "^10.1.3",
    "cross-env": "^10.1.0",
    "eslint": "9.39.2",
    "obuild": "^0.4.22",
    "try": "^1.0.3",
    "tsx": "^4.21.0",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
